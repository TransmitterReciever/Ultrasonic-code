/* ===================== State Machine ===================== */
volatile uint8_t pulse_active = 0;
volatile uint8_t edge_count = 0;
volatile uint8_t trigger_pending = 0;

/* PA2 independent control */
volatile uint8_t pa2_active = 0;
volatile uint8_t pa2_edge_count = 0;

/* ================= PA6→PB1 Time-of-Flight Measurement ================ */
volatile uint32_t pa6_start_time = 0;        /* TIM3 count at PA6 rising edge    */
volatile uint8_t  tof_armed = 0;             /* 1 = PA6 burst started, awaiting echo */
volatile uint8_t  pb1_valid_pulse_count = 0;

/* LED control flags */
volatile uint8_t  led_on_flag = 0;
volatile uint16_t led_timer_count = 0;

/*______________CONFIGURATION______________*/

#define SYS_CLK             48000000        /* System clock in Hz                */

#define FREQUENCY_HZ        67000           /* <<< CHANGE ONLY THIS              */

#define HSE_EXT             1               /* 0 = 8 MHz HSI, 1 = 24 MHz HSE    */
#define REQUIRED_PULSES     8               /* Min valid echo pulses to trigger  */
#define LED_CONST           3               /* CONSTANT DONT CHANGE              */
#define LED_ON_TIME         (LED_CONST * 1) /* 1 = 1 SEC                         */
#define PA6_PULSE_COUNT     4               /* PA6 burst duration in cycles      */
#define PA2_PULSE_COUNT     100             /* PA2 enable-bar duration in cycles */

/* ---------------------------------------------------------------
 * TIM3 prescaler
 *
 * TIM3 is 16-bit (max 65 535).  At 48 MHz that overflows in ~1.37 ms,
 * but a 1 m round-trip takes ~5.83 ms (279 883 ticks @ 48 MHz).
 *
 * Prescaler = 15  →  TIM3 tick = 48 MHz / 16 = 3 MHz
 *   1 m round-trip  = 3 000 000 * 2 / 343 = 17 493 ticks  ✓ fits 16-bit
 *   Max measurable  = 65 535 / 17 493 ≈ 3.75 m            ✓ plenty
 * --------------------------------------------------------------- */
#define TIM3_PRESCALER      15              /* divides SYS_CLK by (PSC+1) = 16  */
#define TIM3_TICK_HZ        (SYS_CLK / (TIM3_PRESCALER + 1))   /* 3 000 000    */

/* Auto-computed carrier period (TIM1 runs at full SYS_CLK, no change) */
#define TARGET_PERIOD       (SYS_CLK / FREQUENCY_HZ)

/* ---------------------------------------------------------------
 * Distance gate — 1 metre ± 10 cm
 *
 * Speed of sound ≈ 343 m/s.
 * Round-trip ticks per metre = TIM3_TICK_HZ * 2 / 343
 *
 * At 3 MHz:  3 000 000 * 2 / 343 = 17 493 ticks/m
 * --------------------------------------------------------------- */
#define TICKS_PER_METRE     (TIM3_TICK_HZ * 2UL / 343UL)       /* 17 493       */
#define DIST_TARGET_CM      100                                  /* 1 metre      */
#define DIST_TOLERANCE_CM   10                                   /* ±10 cm       */

#define DIST_MIN_TICKS  (TICKS_PER_METRE * (DIST_TARGET_CM - DIST_TOLERANCE_CM) / 100UL)
#define DIST_MAX_TICKS  (TICKS_PER_METRE * (DIST_TARGET_CM + DIST_TOLERANCE_CM) / 100UL)


