/* ===================== State Machine ===================== */
volatile uint8_t pulse_active = 0;
volatile uint8_t edge_count = 0;
volatile uint8_t trigger_pending = 0;

/* PA2 independent control */
volatile uint8_t pa2_active = 0;
volatile uint8_t pa2_edge_count = 0;

/* ================= PB1 Frequency Validation ================ */
volatile uint32_t pb1_period_start = 0;
volatile uint32_t pb1_period_measured = 0;
volatile uint8_t pb1_edge_count = 0;
volatile uint8_t pb1_valid_pulse_count = 0;

/* LED control flags */
volatile uint8_t led_on_flag = 0;
volatile uint16_t led_timer_count = 0;

/*______________CONFIGURATION______________*/

#define SYS_CLK             48000000        // System clock in Hz

#define FREQUENCY_HZ        67000           // <<< CHANGE ONLY THIS (e.g. 40000, 66000, 120000)

#define HSE_EXT             1               // 0 = 8MHz HSI, 1 = 24MHz HSE
#define REQUIRED_PULSES     2               // Min echo pulses to trigger LED
#define LED_CONST           3               // CONSTANT DONT CHANGE
#define LED_ON_TIME         (LED_CONST * 1) // 1 = 1SEC
#define PA6_PULSE_COUNT     2               // PA6 burst duration in carrier cycles
#define PA2_PULSE_COUNT     8               // PA2 enable bar duration in carrier cycles

/* Auto-computed from FREQUENCY_HZ — do not edit these */
#define TARGET_PERIOD       (SYS_CLK / FREQUENCY_HZ)
#define FREQ_MIN_PERIOD     (SYS_CLK / (FREQUENCY_HZ * 115 / 100))   // accepts +15% above target freq
#define FREQ_MAX_PERIOD     (SYS_CLK / (FREQUENCY_HZ * 85 / 100))    // accepts -15% below target freq


