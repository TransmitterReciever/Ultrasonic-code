#define SYS_CLK     48000000
#define HALF_PERIOD_US  167   /* 3kHz: toggle every 167us */

void delay_us(uint32_t us) {
    uint32_t start = DWT->CYCCNT;
    uint32_t ticks = us * (SYS_CLK / 1000000);
    while ((DWT->CYCCNT - start) < ticks);
}

int main(void) {
    LL_APB1_GRP2_EnableClock(LL_APB1_GRP2_PERIPH_SYSCFG);
    LL_APB1_GRP1_EnableClock(LL_APB1_GRP1_PERIPH_PWR);
    SystemClock_Config();

    /* Enable DWT for microsecond delays */
    CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
    DWT->CYCCNT = 0;
    DWT->CTRL   |= DWT_CTRL_CYCCNTENA_Msk;

    LL_AHB1_GRP1_EnableClock(LL_AHB1_GRP1_PERIPH_GPIOA);
    LL_GPIO_SetPinMode(GPIOA, LL_GPIO_PIN_4, LL_GPIO_MODE_OUTPUT);
    LL_GPIO_SetPinOutputType(GPIOA, LL_GPIO_PIN_4, LL_GPIO_OUTPUT_PUSHPULL);

    while (1) {
        /* Buzz for 2 seconds: continuously toggle at 3kHz */
        uint32_t end = LL_GetTick() + 2000;
        while (LL_GetTick() < end) {
            GPIOA->BSRR = LL_GPIO_PIN_4;
            delay_us(HALF_PERIOD_US);
            GPIOA->BRR  = LL_GPIO_PIN_4;
            delay_us(HALF_PERIOD_US);
        }

        /* Silent for 2 seconds: pin stays low */
        GPIOA->BRR = LL_GPIO_PIN_4;
        LL_mDelay(2000);
    }
}
