#include "main.h"

/* ============================================================
 *  CONFIGURATION  — only edit values in this block
 * ============================================================
 *
 *  HSE_FREQ_MHZ  8   →  8 MHz crystal  : HSE/2 × 12 = 48 MHz
 *  HSE_FREQ_MHZ  24  →  24 MHz crystal : HSE/2 ×  4 = 48 MHz
 *  HSE_FREQ_MHZ  0   →  internal HSI   : HSI/2 × 12 = 48 MHz
 *
 *  CLK_MODE   0 = PA9 LOW  (off)
 *             1 = PA9 HIGH (static)
 *             2 = PA9 190 kHz PWM (toggle)
 *
 *  AMP_MODE   0 = PA2 LOW  (amplifier off at startup)
 *             1 = PA2 HIGH (amplifier on  at startup)
 *
 *  BUZZER_MODE  0 = PA4 always OFF
 *               1 = PA4 always ON
 *               2 = PA4 on when object detected
 *
 *  BUZZER_TYPE  0 = DC buzzer — PA4 driven as plain GPIO
 *               1 = AC buzzer — PA4 driven with 3 kHz PWM
 *                               via TIM14_CH1 (AF4)
 * ============================================================ */

#define HSE_FREQ_MHZ        24
#define SYS_CLK             48000000

#define FREQUENCY_HZ        190000

#define CLK_MODE            2
#define AMP_MODE            1
#define BUZZER_MODE         2
#define BUZZER_TYPE         1   /* 0 = DC buzzer, 1 = AC buzzer */

#define DIST_MIN_CM         50
#define DIST_MAX_CM         100
#define PULSE_COUNT         10  /* PA6 ON duration: N full cycles of PA9 carrier        */
#define BLANK_CYCLES        100 /* PA2 stays LOW for this many PA9 carrier cycles       */
#define FREQ_TOLERANCE_PCT  15
#define TRIGGER_RATE_HZ     20
#define REQUIRED_PULSES     3
#define CONFIDENCE_WINDOW   5
#define LED_ON_TIME_MS      200

/* ============================================================
 *  END OF CONFIGURATION
 * ============================================================ */

/* ---------- Auto-calculated — do not edit below ------------ */

/* TIM1 carrier */
#define TARGET_PERIOD       (SYS_CLK / FREQUENCY_HZ)

/* TIM14 — trigger timer / AC buzzer PWM */
#if (BUZZER_TYPE == 1)
  #define BUZZER_FREQ_HZ    3000u
  #define TIM14_PSC         15u
  #define TIM14_ARR         ((SYS_CLK / (TIM14_PSC + 1u) / BUZZER_FREQ_HZ) - 1u)
  #define TRIGGER_COUNT     (BUZZER_FREQ_HZ / TRIGGER_RATE_HZ)
#else
  #define TIM14_PSC         47999u
  #define TIM14_ARR         ((1000u / TRIGGER_RATE_HZ) - 1u)
  #define TRIGGER_COUNT     1u
#endif

/* TIM3 echo capture */
#define TIM3_PSC            15u
#define TIM3_TICK_HZ        (SYS_CLK / (TIM3_PSC + 1u))
#define TICKS_PER_METRE     (TIM3_TICK_HZ * 2UL / 343UL)
#define DIST_MIN_TICKS      (TICKS_PER_METRE * DIST_MIN_CM  / 100UL)
#define DIST_MAX_TICKS      (TICKS_PER_METRE * DIST_MAX_CM  / 100UL)
#define FREQ_MIN_TICKS      (TIM3_TICK_HZ / (FREQUENCY_HZ * (100u + FREQ_TOLERANCE_PCT) / 100u))
#define FREQ_MAX_TICKS      (TIM3_TICK_HZ / (FREQUENCY_HZ * (100u - FREQ_TOLERANCE_PCT) / 100u))
#define LISTEN_CYCLES       ((DIST_MAX_TICKS + TICKS_PER_METRE / 2UL) * FREQUENCY_HZ / TIM3_TICK_HZ)
#define LED_HOLD_TICKS      ((LED_ON_TIME_MS * TRIGGER_RATE_HZ) / 1000u)


/* ============================================================
 *  Shared volatile state
 * ============================================================ */

/* Stage 3 — trigger */
static volatile uint8_t  trigger_pending;
#if (BUZZER_TYPE == 1)
static volatile uint16_t irq_count;
#endif

/* Stage 4 — TX burst */
static volatile uint8_t  pulse_active;
static volatile uint8_t  edge_count;

/* Stage 5 — blanking + listen window */
static volatile uint8_t  amp_blanked;
static volatile uint16_t amp_blank_count;
static volatile uint8_t  listen_active;
static volatile uint16_t listen_count;
static volatile uint8_t  tof_armed;

/* Stage 6 — echo capture + detection */
static volatile uint32_t pulse_start_time;
static volatile uint32_t last_capture;
static volatile uint8_t  has_previous;
static volatile uint8_t  valid_pulse_count;
static volatile uint8_t  led_on_flag;
static volatile uint8_t  led_timer;
static volatile uint8_t  miss_count;


/* ============================================================
 *  TIM14 ISR — 20 Hz trigger + buzzer hold / miss counting
 * ============================================================ */

void TIM14_IRQHandler(void)
{
    if (!LL_TIM_IsActiveFlag_UPDATE(TIM14)) return;
    LL_TIM_ClearFlag_UPDATE(TIM14);

#if (BUZZER_TYPE == 1)
    if (++irq_count >= TRIGGER_COUNT)
    {
        irq_count       = 0;
        trigger_pending = 1;
        goto handle_led;
    }
    return;
#else
    trigger_pending = 1;
#endif

handle_led:
    /* Count miss cycles; turn buzzer off after CONFIDENCE_WINDOW consecutive misses */
    if (led_on_flag)
    {
        if (led_timer > 0)
        {
            --led_timer;    /* hold-off period after last hit — don't count misses yet */
        }
        else if (++miss_count >= CONFIDENCE_WINDOW)
        {
            led_on_flag = 0;
            miss_count  = 0;
        }
    }
}


/* ============================================================
 *  TIM1 CC2 ISR — falling edge of PA9 carrier
 *
 *  Controls:  PA6 TX burst (Stage 4)
 *             PA2 amp blanking (Stage 5)
 *             TOF armed flag + pulse_start_time (Stage 6)
 * ============================================================ */

void TIM1_CC_IRQHandler(void)
{
    if (!LL_TIM_IsActiveFlag_CC2(TIM1)) return;
    LL_TIM_ClearFlag_CC2(TIM1);

    /* Start burst on first falling edge after trigger */
    if (trigger_pending && !pulse_active && !listen_active)
    {
        GPIOA->BSRR      = LL_GPIO_PIN_6;
        GPIOA->BRR       = LL_GPIO_PIN_2;
        pulse_start_time = TIM3->CNT;   /* snapshot for TOF measurement */
        edge_count       = 0;
        amp_blank_count  = 0;
        listen_count     = 0;
        has_previous     = 0;
        valid_pulse_count = 0;
        pulse_active     = 1;
        amp_blanked      = 1;
        listen_active    = 1;
        tof_armed        = 0;
        trigger_pending  = 0;
    }

    /* End TX burst after PULSE_COUNT cycles */
    if (pulse_active)
    {
        if (++edge_count >= PULSE_COUNT)
        {
            GPIOA->BRR   = LL_GPIO_PIN_6;
            pulse_active = 0;
        }
    }

    /* Re-enable amp after BLANK_CYCLES, arm echo capture */
    if (amp_blanked)
    {
        if (++amp_blank_count >= BLANK_CYCLES)
        {
            GPIOA->BSRR  = LL_GPIO_PIN_2;
            amp_blanked  = 0;
            tof_armed    = 1;
        }
    }

    /* Close listen window after LISTEN_CYCLES */
    if (listen_active)
    {
        if (++listen_count >= LISTEN_CYCLES)
        {
            tof_armed     = 0;
            listen_active = 0;
        }
    }
}


/* ============================================================
 *  TIM3 CC4 ISR — rising edge on PB1 (echo input)
 *
 *  1. Validates echo frequency (±FREQ_TOLERANCE_PCT of 190 kHz)
 *  2. Validates distance (DIST_MIN_CM – DIST_MAX_CM)
 *  3. On REQUIRED_PULSES consecutive valid pulses: sets led_on_flag
 * ============================================================ */

void TIM3_IRQHandler(void)
{
    if (!LL_TIM_IsActiveFlag_CC4(TIM3)) return;
    LL_TIM_ClearFlag_CC4(TIM3);

    if (!tof_armed) return;

    uint32_t cap = TIM3->CCR4;

    /* First edge — just store as reference, need two edges for period */
    if (!has_previous)
    {
        last_capture = cap;
        has_previous = 1;
        return;
    }

    /* Compute period between two consecutive rising edges (16-bit wraparound safe) */
    uint32_t period = (cap >= last_capture)
                    ? cap - last_capture
                    : 65536UL - last_capture + cap;
    last_capture = cap;

    /* Reject if echo frequency is outside tolerance band */
    if (period < FREQ_MIN_TICKS || period > FREQ_MAX_TICKS)
    {
        valid_pulse_count = 0;
        return;
    }

    /* Compute time-of-flight from burst start (16-bit wraparound safe) */
    uint32_t tof = (cap >= pulse_start_time)
                 ? cap - pulse_start_time
                 : 65536UL - pulse_start_time + cap;

    /* Reject if outside configured distance window */
    if (tof < DIST_MIN_TICKS || tof > DIST_MAX_TICKS)
    {
        valid_pulse_count = 0;
        return;
    }

    /* Valid echo pulse — check if we have enough consecutive hits */
    if (++valid_pulse_count >= REQUIRED_PULSES)
    {
        led_on_flag       = 1;
        led_timer         = LED_HOLD_TICKS;
        miss_count        = 0;
        valid_pulse_count = 0;
    }
}


/* ============================================================
 *  Clock config
 * ============================================================ */

void SystemClock_Config(void)
{
    LL_FLASH_SetLatency(LL_FLASH_LATENCY_1);
    while (LL_FLASH_GetLatency() != LL_FLASH_LATENCY_1);

#if (HSE_FREQ_MHZ > 0)
    LL_RCC_HSE_Enable();
    uint32_t timeout = 100000UL;
    while (!LL_RCC_HSE_IsReady() && --timeout);

    if (timeout > 0)
    {
  #if (HSE_FREQ_MHZ == 24)
        LL_RCC_PLL_ConfigDomain_SYS(LL_RCC_PLLSOURCE_HSE_DIV_2, LL_RCC_PLL_MUL_4);
  #else
        LL_RCC_PLL_ConfigDomain_SYS(LL_RCC_PLLSOURCE_HSE_DIV_2, LL_RCC_PLL_MUL_12);
  #endif
    }
    else
    {
        LL_RCC_HSE_Disable();
        LL_RCC_HSI_Enable();
        while (!LL_RCC_HSI_IsReady());
        LL_RCC_PLL_ConfigDomain_SYS(LL_RCC_PLLSOURCE_HSI_DIV_2, LL_RCC_PLL_MUL_12);
    }
#else
    LL_RCC_HSI_Enable();
    while (!LL_RCC_HSI_IsReady());
    LL_RCC_PLL_ConfigDomain_SYS(LL_RCC_PLLSOURCE_HSI_DIV_2, LL_RCC_PLL_MUL_12);
#endif

    LL_RCC_PLL_Enable();
    while (!LL_RCC_PLL_IsReady());
    LL_RCC_SetAHBPrescaler(LL_RCC_SYSCLK_DIV_1);
    LL_RCC_SetAPB1Prescaler(LL_RCC_APB1_DIV_1);
    LL_RCC_SetSysClkSource(LL_RCC_SYS_CLKSOURCE_PLL);
    while (LL_RCC_GetSysClkSource() != LL_RCC_SYS_CLKSOURCE_STATUS_PLL);
    LL_Init1msTick(SYS_CLK);
    LL_SetSystemCoreClock(SYS_CLK);
}


int main(void)
{
    LL_APB1_GRP2_EnableClock(LL_APB1_GRP2_PERIPH_SYSCFG);
    LL_APB1_GRP1_EnableClock(LL_APB1_GRP1_PERIPH_PWR);
    SystemClock_Config();

    LL_AHB1_GRP1_EnableClock(LL_AHB1_GRP1_PERIPH_GPIOA);
    LL_AHB1_GRP1_EnableClock(LL_AHB1_GRP1_PERIPH_GPIOB);

    /* ---- PA2 — amplifier enable ------------------------------ */
    LL_GPIO_SetPinMode(GPIOA, LL_GPIO_PIN_2, LL_GPIO_MODE_OUTPUT);
#if (AMP_MODE == 1)
    GPIOA->BSRR = LL_GPIO_PIN_2;
#else
    GPIOA->BRR  = LL_GPIO_PIN_2;
#endif

    /* ---- PA9 — TIM1 CH2, 190 kHz carrier --------------------- */
    LL_GPIO_SetPinMode(GPIOA, LL_GPIO_PIN_9, LL_GPIO_MODE_ALTERNATE);
    LL_GPIO_SetAFPin_8_15(GPIOA, LL_GPIO_PIN_9, LL_GPIO_AF_2);
    LL_GPIO_SetPinSpeed(GPIOA, LL_GPIO_PIN_9, LL_GPIO_SPEED_FREQ_HIGH);

    LL_APB1_GRP2_EnableClock(LL_APB1_GRP2_PERIPH_TIM1);
    LL_TIM_SetPrescaler(TIM1, 0);
    LL_TIM_SetAutoReload(TIM1, TARGET_PERIOD - 1u);
    LL_TIM_OC_SetCompareCH2(TIM1, TARGET_PERIOD / 2u);
    LL_TIM_OC_SetMode(TIM1, LL_TIM_CHANNEL_CH2, LL_TIM_OCMODE_PWM1);
    LL_TIM_CC_EnableChannel(TIM1, LL_TIM_CHANNEL_CH2);
    LL_TIM_EnableAllOutputs(TIM1);
    LL_TIM_EnableIT_CC2(TIM1);
    NVIC_SetPriority(TIM1_CC_IRQn, 0);
    NVIC_EnableIRQ(TIM1_CC_IRQn);

    /* ---- PA6 — TX burst output (GPIO) ------------------------- */
    LL_GPIO_SetPinMode(GPIOA, LL_GPIO_PIN_6, LL_GPIO_MODE_OUTPUT);
    LL_GPIO_SetPinSpeed(GPIOA, LL_GPIO_PIN_6, LL_GPIO_SPEED_FREQ_HIGH);
    GPIOA->BRR = LL_GPIO_PIN_6;

    /* ---- PB1 — TIM3 CH4 echo input capture ------------------- */
    LL_GPIO_SetPinMode(GPIOB, LL_GPIO_PIN_1, LL_GPIO_MODE_ALTERNATE);
    LL_GPIO_SetAFPin_0_7(GPIOB, LL_GPIO_PIN_1, LL_GPIO_AF_1);
    LL_GPIO_SetPinPull(GPIOB, LL_GPIO_PIN_1, LL_GPIO_PULL_DOWN);

    LL_APB1_GRP1_EnableClock(LL_APB1_GRP1_PERIPH_TIM3);
    LL_TIM_SetPrescaler(TIM3, TIM3_PSC);
    LL_TIM_SetAutoReload(TIM3, 65535);
    LL_TIM_IC_SetActiveInput(TIM3, LL_TIM_CHANNEL_CH4, LL_TIM_ACTIVEINPUT_DIRECTTI);
    LL_TIM_IC_SetPolarity(TIM3, LL_TIM_CHANNEL_CH4, LL_TIM_IC_POLARITY_RISING);
    LL_TIM_CC_EnableChannel(TIM3, LL_TIM_CHANNEL_CH4);
    LL_TIM_EnableIT_CC4(TIM3);
    NVIC_SetPriority(TIM3_IRQn, 0);
    NVIC_EnableIRQ(TIM3_IRQn);
    LL_TIM_EnableCounter(TIM3);

    /* ---- PA4 — buzzer output ---------------------------------- */
#if (BUZZER_TYPE == 1)
    LL_GPIO_SetPinMode(GPIOA, LL_GPIO_PIN_4, LL_GPIO_MODE_ALTERNATE);
    LL_GPIO_SetAFPin_0_7(GPIOA, LL_GPIO_PIN_4, LL_GPIO_AF_4);
    LL_GPIO_SetPinSpeed(GPIOA, LL_GPIO_PIN_4, LL_GPIO_SPEED_FREQ_HIGH);

    LL_APB1_GRP1_EnableClock(LL_APB1_GRP1_PERIPH_TIM14);
    LL_TIM_SetPrescaler(TIM14, TIM14_PSC);
    LL_TIM_SetAutoReload(TIM14, TIM14_ARR);
    LL_TIM_OC_SetCompareCH1(TIM14, (TIM14_ARR + 1u) / 2u);
    LL_TIM_OC_SetMode(TIM14, LL_TIM_CHANNEL_CH1, LL_TIM_OCMODE_FORCED_INACTIVE);
    LL_TIM_CC_EnableChannel(TIM14, LL_TIM_CHANNEL_CH1);
    LL_TIM_EnableAllOutputs(TIM14);
#else
    LL_GPIO_SetPinMode(GPIOA, LL_GPIO_PIN_4, LL_GPIO_MODE_OUTPUT);
    GPIOA->BRR = LL_GPIO_PIN_4;

    LL_APB1_GRP1_EnableClock(LL_APB1_GRP1_PERIPH_TIM14);
    LL_TIM_SetPrescaler(TIM14, TIM14_PSC);
    LL_TIM_SetAutoReload(TIM14, TIM14_ARR);
#endif
    LL_TIM_EnableIT_UPDATE(TIM14);
    NVIC_SetPriority(TIM14_IRQn, 1);
    NVIC_EnableIRQ(TIM14_IRQn);
    LL_TIM_EnableCounter(TIM14);

    /* Start TIM1 last so ISR doesn't fire before TIM3 is running */
    LL_TIM_EnableCounter(TIM1);

    /* ---- Main loop — drive buzzer from detection flag --------- */
    while (1)
    {
#if (BUZZER_TYPE == 1)
        if (led_on_flag)
            LL_TIM_OC_SetMode(TIM14, LL_TIM_CHANNEL_CH1, LL_TIM_OCMODE_PWM1);
        else
            LL_TIM_OC_SetMode(TIM14, LL_TIM_CHANNEL_CH1, LL_TIM_OCMODE_FORCED_INACTIVE);
#else
        if (led_on_flag)
            GPIOA->BSRR = LL_GPIO_PIN_4;
        else
            GPIOA->BRR  = LL_GPIO_PIN_4;
#endif
    }
}


void Error_Handler(void)
{
    __disable_irq();
    while (1);
}

